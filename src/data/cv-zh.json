    {
      "id": "internship",
      "title": "实习经历",
      "entries": [
        {
          "title": "产品经理",
          "meta": "Shopee，北京",
          "year": "2022.01 – 2022.05",
          "details": [
            "优化激励与增长体系：通过引入任务发布、导师任务以及视频观看分阶段反馈，将 Shopee 视频平台的 DAU 从 170 万提升至 210 万。",
            "提升用户留存：设计并上线基于激励机制的视频互动功能，使人均观看时长增加 1.2 分钟。",
            "增强用户参与度：策划并落地节日/活动主题页，带来额外 3.2 万日活用户，并通过新增快捷入口和绿色频道将视频转化率提升 5%。"
          ]
        },
        {
          "title": "产品经理",
          "meta": "快手(快影)，深圳",
          "year": "2021 – 2022",
          "details": [
            "用户体验与功能优化：主导短视频检索、流媒体播放与内容展示的优化，素材库浏览量提升23%；设计创新编辑工具，封面浏览量提升13%，分享量提升17%。",
            "自动化与AI集成：与图像识别团队协作，实现视频帧分析与内容筛选自动化，提升交互准确性和效率。",
            "产品指标与影响：搭建反馈机制，将日活用户留存率从30%提升到35%，优化视频/图片管理，支持350万日活用户的运营需求。",
            "专利成果：作为主要发明人，获得快影App封面模板智能推荐专利（专利号：2021KT2414）。"
          ]
        },
        {
          "title": "AI 产品经理",
          "meta": "滴滴出行，北京",
          "year": "2021 – 2022",
          "details": [
            "SaaS平台开发：参与外呼自动化产品研发，撰写核心平台功能（账户管理、企业认证、企业管理、智能黑名单）PRD，推动UI评审和功能迭代。",
            "管理平台优化：编写任务优化与企业审核流程相关PRD，简化内部流程，提升行政效率。",
            "竞品调研与分析：完成百度云、阿里云等竞品分析报告，提炼账户资产中心关键指标，为产品定位提供支撑。",
            "数据驱动项目交付：主导语音识别模型（n=1000）交互准确性评估，输出数据驱动报告，提升产品透明度和可靠性。"
          ]
        },
        {
          "title": "产品经理",
          "meta": "网易有道（超级词典），北京",
          "year": "2020 – 2021",
          "details": [
            "产品规划与战略：负责 AI 驱动教育工具超过 70% 功能模块的规划与管理，撰写并交付 12+ PRD，涵盖听力、阅读、写作批改、全局音频与家长控制等核心功能。",
            "用户研究与市场洞察：主导大规模用户研究（含 3000 份问卷、105 人量化实验、20 次深度访谈），结合竞品分析（如科大讯飞、小爱、微信读书），形成用户画像、市场细分与可落地的游戏化方案。",
            "功能开发与优化：撰写 10 份 PRD（5 个新功能、5 个优化），显著改善牛津词典集成及整体用户界面体验。"
          ]
        }
      ]
